/target/
**/*.rs.bk
.DS_Store
.idea/
.vscode/
*.swp
.env
.env.*
!.env.example
# Local Ferrum path override belongs in .cargo/config.toml.example.
# .cargo/config.toml is tracked for the Xcode SDK workaround.
# Local FHIR validator cache (HL7 validator_cli.jar — not vendored)
.cache/
# CLI demo key sidecars (raw private key bytes — never commit)
*.ephemeral-keypair.json
# Compliance worked-example run outputs (keys + synthetic clinical placeholders)
examples/compliance-worked-example/artifacts/run-*
examples/compliance-worked-example/artifacts/latest
examples/compliance-worked-example/artifacts/migration-rehearsal/
# FHIR IPS export / validator working files
examples/fhir-ips-export/out/
